# =============================================
# TypeMind AI — Environment Variables Example
# =============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB ---
# Example: mongodb+srv://user:password@cluster.mongodb.net/typemind
MONGO_URI=

# --- JWT ---
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d

# --- Client ---
CLIENT_URL=http://localhost:5173

# --- AI Provider (OpenAI-compatible) ---
# Works with OpenAI, Google Gemini (openai-compat), or any OpenAI-spec API
AI_API_KEY=
# Example: gemini-2.0-flash  |  gpt-4o-mini
AI_MODEL=gemini-2.0-flash
# Leave blank for OpenAI default. For Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
AI_BASE_URL=

# --- Bcrypt ---
BCRYPT_ROUNDS=12